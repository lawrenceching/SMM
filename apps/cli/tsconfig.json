{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@smm/types": ["../../packages/types/types.ts"],
      "@smm/types/*": ["../../packages/types/*"],
      "@smm/utils": ["../../packages/utils/src/index.ts"],
      "@smm/utils/*": ["../../packages/utils/src/*.ts"],
      "@smm/core": ["../core/src/index.ts"],
      "@smm/core/createRenameEpisodePlan": [
        "../core/src/pipeline/createRenameEpisodePlan.ts"
      ],
      "@smm/core/FsPort": ["../core/src/ports/FsPort.ts"],
      "@smm/core/*": ["../core/src/*"],
      "@smm/core-routes": ["../../packages/core-routes/src/index.ts"],
      "@smm/tvdb4": ["../../packages/tvdb4/src/index.ts"],
      "@smm/tvdb4/*": ["../../packages/tvdb4/src/*"],
      "@smm/test": ["../../packages/test/src/index.ts"],
      "@smm/test/*": ["../../packages/test/*"]
    }
  }
}
