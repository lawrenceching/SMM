{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "allowJs": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    "baseUrl": ".",
    "paths": {
      "@smm/types": ["../../packages/types/types.ts"],
      "@smm/types/*": ["../../packages/types/*.ts"],
      "@smm/utils": ["../../packages/utils/src/index.ts"],
      "@smm/utils/*": ["../../packages/utils/src/*.ts"],
      "@smm/tvdb4": ["../../packages/tvdb4/src/index.ts"],
      "@smm/tvdb4/*": ["../../packages/tvdb4/src/*"],
      "@smm/test": ["../../packages/test/src/index.ts"]
    }
  }
}
