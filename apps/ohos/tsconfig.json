{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@smm/types": ["../../packages/types/types.ts"],
      "@smm/types/*": ["../../packages/types/*"],
      "@smm/utils": ["../../packages/utils/src/index.ts"],
      "@smm/utils/*": ["../../packages/utils/src/*.ts"],
      "@smm/core": ["../core/src/index.ts"],
      "@smm/core/createRenameEpisodePlan": [
        "../core/src/pipeline/createRenameEpisodePlan.ts"
      ],
      "@smm/core/FsPort": ["../core/src/ports/FsPort.ts"],
      "@smm/core/*": ["../core/src/*"],
      "@smm/core-routes": ["../../packages/core-routes/src/index.ts"],
      "@smm/core-routes/*": ["../../packages/core-routes/src/*"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules"]
}
