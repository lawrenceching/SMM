{
    "name": "smm-e2e",
    "outputDir": "./artifacts/cicd",
    "env": {
        "BROWSER_LOG_ENABLED": "true",
        "NETWORK_LOG_ENABLED": "true",
        "SMM_AUTH_TOKEN": "ChangeMe123"
    },
    "background": [
        {
            "name": "cli",
            "command": "pnpm e2e:cli"
        },
        {
            "name": "ui",
            "command": "pnpm dev:ui"
        }
    ],
    "tasks": [
        {
            "name": "wait-ready",
            "command": "bun ci/wait-for-e2e-ready.ts"
        },
        {
            "name": "ScrapeFailover.e2e.ts",
            "command": "pnpm wdio --spec ./common/tv/ScrapeFailover.e2e.ts",
            "cwd": "apps/e2e"
        }
    ],
    "afterEach": [
        {
            "name": "collect-wdio-report",
            "command": "bun ci/collect-wdio-report.ts"
        }
    ],
    "onArtifactsReady": [
        {
            "name": "check-log",
            "command": "bun ./apps/e2e/scenarios/check-log.ts",
            "when": "success"
        }
    ],
    "stopOnFailure": false,
    "keepRawTimeline": true
}
