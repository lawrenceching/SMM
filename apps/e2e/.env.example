
TMDB_HOST=https://api.themoviedb.org/3
TMDB_API_KEY=
# When USE_EMBEDDED_HTTP_PROXY is true (default on local/electron), e2e starts a
# local forwarder and ignores TMDB_HTTP_PROXY / TVDB_HTTP_PROXY. That only works
# if this host can reach official TMDB/TVDB directly. If those hosts are blocked,
# set USE_EMBEDDED_HTTP_PROXY=false and point the proxies at a working outbound
# HTTP proxy (e.g. Clash).
# HarmonyOS (ohos) always ignores embedded proxy and requires TMDB_HTTP_PROXY /
# TVDB_HTTP_PROXY (device cannot reach a host-local 127.0.0.1 proxy).
USE_EMBEDDED_HTTP_PROXY=true 
TMDB_HTTP_PROXY=http://127.0.0.1:7897
TVDB_HTTP_PROXY=http://127.0.0.1:7897
DEEPSEEK_API_KEY=

# Netscape cookies file for common/manual/MusicPanel-Download.e2e.ts (Bilibili tests).
# Path is relative to repo root. Export cookies to a file; do not paste cookie text here.
BILIBILI_COOKIES_FILE=.local/bilibili.txt

# Set to "true" to capture browser network requests via WebDriver BiDi
# NETWORK_LOG_ENABLED=true