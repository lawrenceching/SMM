{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Include mocha and node types for test hooks and fs/path/os modules
    "types": ["mocha", "node", "bun"],

    // Monorepo paths
    "baseUrl": ".",
    "paths": {
      "@smm/core": ["../../packages/core/path.ts"],
      "@smm/core/*": ["../../packages/core/*"],
      "@smm/test": ["../../packages/test/src/index.ts"],
      "@smm/test/*": ["../../packages/test/*"]
    }
  },
  "include": [
    "test/**/*.ts",
    "common/**/*.ts",
    "scenarios/**/*.ts",
    "wdio.conf.ts",
    "wdio.conf.test.ts"
  ],
  "exclude": [
    "node_modules",
    "common/manual",
    "ohos",
    "electron"
  ]
}
