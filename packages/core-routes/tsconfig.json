{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@smm/types": ["../types/types.ts"],
      "@smm/types/*": ["../types/*"],
      "@smm/utils": ["../utils/src/index.ts"],
      "@smm/utils/*": ["../utils/src/*.ts"],
      "@smm/core": ["../../apps/core/src/index.ts"],
      "@smm/core/createRenameEpisodePlan": [
        "../../apps/core/src/pipeline/createRenameEpisodePlan.ts"
      ],
      "@smm/core/FsPort": ["../../apps/core/src/ports/FsPort.ts"],
      "@smm/core/*": ["../../apps/core/src/*"]
    }
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules"]
}
