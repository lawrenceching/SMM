{
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "3pp": {
    "ffmpeg_version": "8.1",
    "ytdlp_version": "2026.07.04",
    "videocaptioner_version": "1.0.0"
  },
  "scripts": {
    "dev": "cross-env UI_PORT=8081 CLI_PORT=8082 npm-run-all2 --parallel dev:ui dev:cli",
    "dev:ui": "pnpm --filter ui dev",
    "dev:cli": "cross-env SMM_AUTH_ENABLED=true SMM_AUTH_TOKEN=ChangeMe123 pnpm --filter cli dev",
    "e2e:cli": "cross-env SMM_AUTH_ENABLED=true SMM_AUTH_TOKEN=ChangeMe123 pnpm --filter cli start",
    "dev:electron": "cd apps/electron && pnpm run dev",
    "build": "pnpm run build:cli && pnpm run build:ui",
    "build:cli": "cd apps/cli && pnpm run build",
    "build:ui": "cd apps/ui && pnpm run build",
    "build:electron": "pnpm run typecheck:types && pnpm run typecheck:utils && pnpm run typecheck:core && pnpm --filter cli build && pnpm --filter ui build && pnpm --filter electron build",
    "build:types": "cd packages/types && pnpm run typecheck",
    "build:utils": "cd packages/utils && pnpm run typecheck",
    "build:docker": "docker buildx build --progress=plain -f apps/docker/Dockerfile -t smm:latest .",
    "build:docker:pkgs": "pnpm --filter \"docker...\" run build",
    "build:e2e": "docker build -t smm-e2e:test -f apps/e2e/Dockerfile .",
    "test": "pnpm -r test",
    "test:types": "cd packages/types && pnpm test",
    "test:utils": "cd packages/utils && pnpm test",
    "test:core": "cd apps/core && pnpm test",
    "test:core-routes": "cd packages/core-routes && pnpm test",
    "test:electron-common": "cd packages/electron-common && pnpm test",
    "test:cli": "cd apps/cli && pnpm test",
    "test:cli:e2e": "cd apps/cli && pnpm run test:e2e",
    "e2e:cli:bun": "bun ci/run-cli-e2e-test.ts",
    "test:ui": "cd apps/ui && pnpm test",
    "test:e2e": "cd apps/e2e && pnpm run test",
    "e2e:ai": "bun ci/run-e2e-test.ts --spec \"./test/specs/ai/*.e2e.ts\"",
    "e2e:config": "bun ci/run-e2e-test.ts --spec \"./common/config/*.e2e.ts\" --spec \"./common/httpproxy/*.e2e.ts\"",
    "e2e:mcp": "bun test test/mcp/",
    "e2e:mcp:ui": "bun ci/run-e2e-test.ts --spec \"./common/mcp/*.e2e.ts\"",
    "e2e:mcp:ui:v3": "bun ci/run-e2e-test.ts --spec \"./common/mcp/*.e2e.ts\"",
    "e2e:media-folder-initialization": "bun ci/run-e2e-test.ts --spec \"./common/tv/ImportTvShowLibrary.e2e.ts\" --spec \"./common/tv/Initialize*.e2e.ts\" --spec \"./common/movie/ImportMovieLibrary.e2e.ts\" --spec \"./common/movie/Initialize*.e2e.ts\"",
    "e2e:movie": "bun ci/run-e2e-test.ts --spec \"./common/movie/SearchMovie.e2e.ts\" --spec \"./common/movie/Movie-RenameVideoFile.e2e.ts\"",
    "e2e:music": "bun ci/run-e2e-test.ts --spec \"./common/music/*.e2e.ts\"",
    "e2e:other": "bun ci/run-e2e-test.ts --spec \"./common/other/*.e2e.ts\"",
    "e2e:transcribe": "bun ci/run-e2e-test.ts --spec \"./common/manual/Transcribe.e2e.ts\" --spec \"./common/manual/MusicPanel-Transcribe.e2e.ts\"",
    "e2e:tv": "bun ci/run-e2e-test.ts --spec \"./common/tv/*.e2e.ts\"",
    "e2e:tvdb": "bun ci/run-e2e-test.ts --spec \"./common/tvdb/*.e2e.ts\"",
    "e2e:ohos": "bun ci/run-e2e-test.ts --platform ohos --spec \"./ohos/**/*.e2e.ts\"",
    "e2e:local:tv": "bun ci/run-e2e-test.ts --spec \"./common/tv/*.e2e.ts\"",
    "e2e:ohos:tv": "bun ci/run-e2e-test.ts --platform ohos --spec \"./common/tv/*.e2e.ts\"",
    "e2e:electron:tv": "bun ci/run-e2e-test.ts --platform electron --spec \"./common/tv/*.e2e.ts\"",
    "e2e:failover": "cross-env EXTERNAL_CONFIG_FILE_URL=\"http://localhost:8000/config.json\" bun ci/run-e2e-test.ts --spec ./common/tv/TmdbHostFailover.e2e.ts",
    "e2e:http-proxy": "bun apps/cicd/run.ts -f apps/e2e/scenarios/http-proxy-reverse-proxy.test.json",
    "typecheck": "pnpm run typecheck:types && pnpm run typecheck:utils && pnpm run typecheck:core && pnpm run typecheck:core-routes && pnpm run typecheck:electron-common && pnpm run typecheck:cli && pnpm run typecheck:ui && pnpm run typecheck:e2e && pnpm run typecheck:electron",
    "typecheck:types": "cd packages/types && pnpm run typecheck",
    "typecheck:utils": "cd packages/utils && pnpm run typecheck",
    "typecheck:core": "cd apps/core && pnpm run typecheck",
    "typecheck:core-routes": "cd packages/core-routes && pnpm run typecheck",
    "typecheck:electron-common": "cd packages/electron-common && pnpm run typecheck",
    "typecheck:cli": "cd apps/cli && pnpm run typecheck",
    "typecheck:ui": "cd apps/ui && pnpm run typecheck",
    "typecheck:e2e": "cd apps/e2e && pnpm run typecheck",
    "typecheck:electron": "cd apps/electron && pnpm run typecheck",
    "typecheck:ohos-main": "pnpm --filter @smm/ohos-electron-main typecheck",
    "ci": "pnpm run build && pnpm run test && pnpm run typecheck",
    "ci:cli": "cd apps/cli && pnpm run test && pnpm run typecheck",
    "build:ohos": "bash ./ci/build-ohos.sh",
    "changeset": "changeset",
    "changeset:version": "changeset version && pnpm i && pnpm run build:cli",
    "changeset:publish": "changeset publish",
    "query-network-log": "bun apps/tools/query-network-log.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@modelcontextprotocol/inspector": "^2.3.0",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "npm-run-all2": "^8.0.4"
  }
}
